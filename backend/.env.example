# Copy to backend/.env — the API reads it at startup. Restart `npm run dev` after changing it.

# AI provider (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Conversation context and rolling-memory budgets (approximate tokens)
CONTEXT_TOKEN_BUDGET=6000
RECENT_CONTEXT_TOKEN_BUDGET=2600
SUMMARY_TRIGGER_TOKENS=4200
SUMMARY_TRIGGER_MESSAGES=12

# Primary Google Shopping product search (https://serpapi.com)
SERPAPI_API_KEY=

# Web research and fallback search (https://tavily.com)
TAVILY_API_KEY=

# Optional licensed supplier/OEM adapter. Expected API contract is documented in README.md.
AUTHORIZED_CATALOG_URL=
AUTHORIZED_CATALOG_API_KEY=

# Optional. Auto-detected on common Windows/Linux installs when blank.
CHROME_EXECUTABLE_PATH=

# PostgreSQL in Docker (`npm run db:up`)
DATABASE_URL=postgres://autoparts:autoparts@127.0.0.1:5442/autoparts

HOST=127.0.0.1
PORT=8787

# Production: NODE_ENV=production enables Secure cookies, HSTS, generic error messages,
# and refuses the development DATABASE_URL above.
NODE_ENV=development
# Reverse-proxy hops in front of the API (0 if exposed directly). Used for per-IP rate limits.
TRUST_PROXY=1
# Keep false. Set true only in a container that cannot run Chrome's sandbox (PDF export).
CHROME_NO_SANDBOX=false
# Production: the API serves the built frontend (npm run build) from ../frontend/dist with the
# same security headers. Override the folder here if it lives elsewhere.
FRONTEND_DIST=
